{
  "name": "sift",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samaksh-bajaj/sift.git"
  },
  "bugs": {
    "url": "https://github.com/samaksh-bajaj/sift/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @sift/web dev",
    "build": "pnpm -r build && pnpm build:backend",
    "build:backend": "node scripts/build-backend.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "node scripts/test-db.mjs",
    "test:backend": "pnpm build:backend && deno test --allow-env --allow-read --config supabase/functions/deno.json supabase/functions/_shared/handler.test.ts",
    "typecheck:backend": "pnpm build:backend && deno check --config supabase/functions/deno.json supabase/functions/extract-item/index.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/chrome": "^0.1.24",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "deno": "^2.9.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^3.2.0"
  }
}
