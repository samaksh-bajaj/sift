{
  "name": "sift",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samaksh-bajaj/sift.git"
  },
  "bugs": {
    "url": "https://github.com/samaksh-bajaj/sift/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @sift/web dev",
    "build": "pnpm -r build && pnpm build:backend",
    "build:backend": "node scripts/build-backend.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "node scripts/test-db.mjs",
    "test:backend": "pnpm build:backend && deno test --allow-env --allow-read --config supabase/functions/deno.json supabase/functions/_shared/handler.test.ts",
    "typecheck:backend": "pnpm build:backend && deno check --config supabase/functions/deno.json supabase/functions/extract-item/index.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "deno": "^2.9.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
